# Shared editor settings for every IDE and contributor
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.java]
ij_java_method_call_chain_wrap = normal
ij_java_align_multiline_chained_methods = true

[*.{js,jsx,ts,tsx,json,yml,yaml,scss,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false